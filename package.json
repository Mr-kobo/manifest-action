{
    "name": "nuxt-boilerplate",
    "description": "Keep calm traveler, it's boiling...",
    "version": "0.3.6",
    "private": true,
    "scripts": {
        "start": "npm run dev",
        "dev": "npm run docker:dev && nuxt dev --port 4200",
        "build": "nuxt build --verbose",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "docker:dev": "docker compose -f dockers/docker-compose.yml up -d",
        "docker:staging": "docker-compose -f dockers/docker-compose-staging.yml up --build -d",
        "docker:prod": "docker-compose -f dockers/docker-compose-prod.yml up --build -d",
        "build:serverless": "cross-env SERVERLESS=true && nuxt build",
        "live:serverless": "cross-env LIVE=true SERVERLESS=true && nuxt dev",
        "dev:serverless": "cross-env SERVERLESS=true && nuxt dev",
        "netlify:dev": "netlify env:set LIVE false --context dev && netlify dev",
        "netlify:live": "netlify env:set LIVE true --context dev && netlify dev --live=staging",
        "local:build": "npm run docker:dev && export LOCAL=true && npm run build && nuxt start --port 4200"
    },
    "devDependencies": {
        "@nuxt/devtools": "1.6.1",
        "@nuxt/icon": "^1.8.2",
        "@types/config": "3.3.5",
        "@types/fs-extra": "11.0.4",
        "@types/lodash": "^4.17.14",
        "@types/mustache": "4.2.5",
        "@types/qrcode": "1.5.5",
        "@types/sanitize-html": "2.13.0",
        "@types/set-cookie-parser": "2.4.10",
        "@types/speakeasy": "2.0.10",
        "@types/uuid": "10.0.0",
        "@types/validator": "13.7.17",
        "cross-env": "7.0.3",
        "nodemailer": "6.9.16",
        "typescript": "5.7.2"
    },
    "dependencies": {
        "@nuxt/content": "2.13.4",
        "@nuxt/test-utils": "3.14.4",
        "@nuxt/ui": "^4.1.0",
        "@nuxtjs/i18n": "10.0.6",
        "@nuxtjs/tailwindcss": "6.12.2",
        "@sentry/browser": "8.41.0",
        "@sentry/node": "8.41.0",
        "@sentry/serverless": "7.114.0",
        "@sentry/tracing": "7.114.0",
        "@sidebase/nuxt-auth": "0.9.4",
        "@tanstack/vue-table": "^8.21.3",
        "@vueup/vue-quill": "1.2.0",
        "@vueuse/core": "12.0.0",
        "@vueuse/router": "12.0.0",
        "ably": "2.5.0",
        "axios": "1.7.8",
        "fs-extra": "11.2.0",
        "lodash": "4.17.21",
        "mailersend": "2.3.0",
        "material-design-icons-iconfont": "6.7.0",
        "mime": "4.0.4",
        "moment": "2.30.1",
        "moment-timezone": "0.5.46",
        "mongodb": "6.11.0",
        "mongoose": "8.8.3",
        "mongoose-autopopulate": "1.1.0",
        "mustache": "4.2.0",
        "next-auth": "~4.21.1",
        "nuxt": "^4.1.3",
        "qrcode": "1.5.4",
        "sanitize-html": "2.13.1",
        "set-cookie-parser": "2.7.1",
        "sharp": "0.33.5",
        "slugify": "1.6.6",
        "speakeasy": "2.0.0",
        "tailwindcss": "^4.0.6",
        "toad-scheduler": "3.0.1",
        "ts-node": "10.9.2",
        "uuid": "11.0.3",
        "validator": "13.12.0",
        "vitest": "2.1.6",
        "vue-pdf-embed": "2.1.1",
        "vue3-lottie": "^3.3.1",
        "word-list": "4.1.0",
        "zod": "4.1.12"
    }
}
